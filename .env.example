# Kakao Developers > 앱 > JavaScript 키
# 허용 도메인에 http://localhost:3000 과 실제 Vercel 도메인을 등록하세요.
NEXT_PUBLIC_KAKAO_MAP_APP_KEY=

# Better Auth와 Kakao Login은 인증 세로 기능 구현 시 설정합니다.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# 로컬 Docker PostgreSQL. 운영에서는 DATABASE_URL은 pooled, DIRECT_URL은 direct 연결입니다.
DATABASE_URL=postgresql://gatgaga:gatgaga_local@localhost:54329/gatgaga?schema=public
DIRECT_URL=postgresql://gatgaga:gatgaga_local@localhost:54329/gatgaga?schema=public
